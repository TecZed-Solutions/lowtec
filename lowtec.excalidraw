    {
      "id": "WCQ3_2DsOHAjgGi2MnSJE",
      "type": "text",
      "x": 698.5948274622136,
      "y": 389.17733769162373,
      "width": 664.4286497108262,
      "height": 60,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 1570210581,
      "version": 449,
      "versionNonce": 1574260394,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790617852302,
      "created": 1790266877693,
      "link": null,
      "locked": false,
      "text": "O sistema permitirá que o cliente conheça o produto, consulte suas informações e,\napós decidir pela aquisição, seja direcionado ao checkout para realizar o pagamento\npor PIX ou cartão de crédito/débito.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O sistema permitirá que o cliente conheça o produto, consulte suas informações e, após decidir pela aquisição, seja direcionado ao checkout para realizar o pagamento por PIX ou cartão de crédito/débito.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "A4ca1y0YHa-bzpnf5_3Dz",
      "type": "text",
      "x": 697.1437710468971,
      "y": 465.3167360432822,
      "width": 688.4015003583705,
      "height": 80,
      "angle": 0,
      "strokeColor": "#343a40",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0h",
      "roundness": null,
      "seed": 199599291,
      "version": 486,
      "versionNonce": 334735099,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790266954559,
      "created": 1790266877693,
      "link": null,
      "locked": false,
      "text": "A plataforma será integrada a um meio de pagamento para processamento e validação\ndas transações. Após a confirmação do pagamento, o sistema identificará\nautomaticamente a compra aprovada e realizará a liberação ou entrega do produto\nadquirido ao cliente.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A plataforma será integrada a um meio de pagamento para processamento e validação das transações. Após a confirmação do pagamento, o sistema identificará automaticamente a compra aprovada e realizará a liberação ou entrega do produto adquirido ao cliente.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
