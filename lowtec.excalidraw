    {
      "id": "RtYPV8POZxGQ7XuWFFrtt",
      "type": "text",
      "x": 2964.1267893489758,
      "y": 1929.664407782914,
      "width": 793.91943359375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4a",
      "roundness": null,
      "seed": 782028110,
      "version": 221,
      "versionNonce": 863148801,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790967112365,
      "created": 1790880383676,
      "link": null,
      "locked": false,
      "text": "Me ajude a desenvolver a hero section de minha página de produto, ele produto\nconsiste em um e-book de prompts para imagens profissionais, englobando vários\nângulos, posições, efeitos entre outras características para melhorar a imagem\nanexada da pessoa. Por enquanto tenho como design system este globals.css e\ncomo logomarca as imagens anexadas. O projeto deve ser feito em Next.js com\ntypescript e tailwind.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Me ajude a desenvolver a hero section de minha página de produto, ele produto consiste em um e-book de prompts para imagens profissionais, englobando vários ângulos, posições, efeitos entre outras características para melhorar a imagem anexada da pessoa. Por enquanto tenho como design system este globals.css e como logomarca as imagens anexadas. O projeto deve ser feito em Next.js com typescript e tailwind.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
