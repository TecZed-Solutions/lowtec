# ============================================
# SERVER
# ============================================

PORT=3001
NODE_ENV=development

# ============================================
# DATABASE
# ============================================

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

# ============================================
# AUTHENTICATION - JWT
# ============================================

JWT_USUARIO=your_user_jwt_secret
JWT_ADMIN=your_admin_jwt_secret

# ============================================
# RESEND - EMAIL SERVICE
# ============================================

RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL="LowTec <no-reply@yourdomain.com>"

# ============================================
# CLOUDFLARE R2 - OBJECT STORAGE
# ============================================

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Buckets
R2_BUCKET_PUBLIC_NAME=lowtec
R2_BUCKET_PRIVATE_NAME=lowtec-private

# Public bucket URL
R2_PUBLIC_URL=https://your-public-bucket.r2.dev

# ============================================
# FRONTEND
# ============================================

FRONTEND_URL=http://localhost:3000

# ============================================
# GOOGLE AUTHENTICATION
# ============================================

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ============================================
# INFINITEPAY - PAYMENT GATEWAY
# ============================================

INFINITEPAY_API_URL=https://api.infinitepay.io
INFINITEPAY_HANDLE=your_infinitepay_handle

INFINITEPAY_REDIRECT_URL=http://localhost:3000/pagamento/retorno
INFINITEPAY_WEBHOOK_URL=https://your-public-api.com/api/webhooks/infinitepay
